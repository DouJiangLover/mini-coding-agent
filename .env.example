# Use auto to run the bundled offline demo when no API key is present.
TRACECODER_DEMO=auto

# DeepSeek-first model configuration. Never commit a real key.
DEEPSEEK_API_KEY=

# Optional generic OpenAI-compatible fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# The backend rejects workspaces outside this directory.
TRACE_WORKSPACE_ROOT=.
TRACECODER_MAX_STEPS=30
TRACECODER_STEP_DELAY=0.2
TRACECODER_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Browser-visible backend address for the frontend build.
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
